#!/usr/bin/env python3
"""
HytaleCrypt — End-to-End encrypted messaging for Hytale chat.

Encrypt a message → base64 blob → paste into /msg <player> <blob>
Recipient copies blob → decrypts locally.

Key exchange happens OUT of band (Discord, Steckdose, whatever).
"""

import argparse
import base64
import os
import sys
from pathlib import Path

from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import rsa, padding
from cryptography.hazmat.primitives.asymmetric.rsa import RSAPrivateKey, RSAPublicKey
from cryptography.hazmat.backends import default_backend

# Share one crypto/keystore implementation with the hytale-tunnel overlay.
# Locate the hytale_tunnel package across install layouts (Linux ~/.local/lib,
# or the package sitting next to / one level below this script on Windows).
def _add_pkg_path():
    from pathlib import Path
    here = Path(__file__).resolve().parent
    for cand in (here, here / "lib", here.parent / "lib",
                 Path(os.path.expanduser("~/.local/lib"))):
        if (cand / "hytale_tunnel").is_dir():
            sys.path.insert(0, str(cand))
            return
_add_pkg_path()
from hytale_tunnel import crypto as _hc

CONFIG_DIR = _hc.CONFIG_DIR
MY_KEY_DIR = CONFIG_DIR
MY_PRIV_PATH = _hc.MY_PRIV_PATH
MY_PUB_PATH  = _hc.MY_PUB_PATH
FRIENDS_DIR  = _hc.FRIENDS_DIR


# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

def _ensure_dirs():
    MY_KEY_DIR.mkdir(parents=True, exist_ok=True)
    FRIENDS_DIR.mkdir(parents=True, exist_ok=True)


def _load_privkey(path: Path = MY_PRIV_PATH) -> RSAPrivateKey:
    if not path.exists():
        print(f"❌ No private key found at {path}", file=sys.stderr)
        print("   Run: hytalecrypt gen", file=sys.stderr)
        sys.exit(1)
    data = path.read_bytes()
    return serialization.load_pem_private_key(data, password=None, backend=default_backend())


def _load_pubkey(path: Path) -> RSAPublicKey:
    data = path.read_bytes()
    return serialization.load_pem_public_key(data, backend=default_backend())


def _friend_pubkey(name: str) -> RSAPublicKey:
    path = FRIENDS_DIR / f"{name}.pub"
    if not path.exists():
        names = sorted(p.stem for p in FRIENDS_DIR.glob("*.pub"))
        if not names:
            print(f"❌ No friends imported yet.", file=sys.stderr)
            print("   Import one: hytalecrypt import <name> <base64_public_key>", file=sys.stderr)
            sys.exit(1)
        print(f"❌ Unknown friend '{name}'. Known: {', '.join(names)}", file=sys.stderr)
        sys.exit(1)
    return _load_pubkey(path)


def _pubkey_to_b64(pub: RSAPublicKey) -> str:
    pem = pub.public_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.PublicFormat.SubjectPublicKeyInfo,
    )
    return base64.b64encode(pem).decode()


def _b64_to_pubkey(b64: str) -> RSAPublicKey:
    pem = base64.b64decode(b64)
    return serialization.load_pem_public_key(pem, backend=default_backend())


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

def cmd_gen(args):
    """Generate a new RSA keypair."""
    _ensure_dirs()
    if MY_PRIV_PATH.exists():
        print(f"⚠️  Key already exists at {MY_PRIV_PATH}")
        if input("Overwrite? [y/N] ").strip().lower() != "y":
            print("Cancelled.")
            return

    key = rsa.generate_private_key(
        public_exponent=65537,
        key_size=2048,
        backend=default_backend(),
    )

    # private key
    MY_PRIV_PATH.write_bytes(
        key.private_bytes(
            encoding=serialization.Encoding.PEM,
            format=serialization.PrivateFormat.PKCS8,
            encryption_algorithm=serialization.NoEncryption(),
        )
    )
    MY_PRIV_PATH.chmod(0o600)

    # public key
    pub = key.public_key()
    MY_PUB_PATH.write_bytes(
        pub.public_bytes(
            encoding=serialization.Encoding.PEM,
            format=serialization.PublicFormat.SubjectPublicKeyInfo,
        )
    )

    fingerprint = _hc.fingerprint(pub)

    print(f"✅ Keypair generated!")
    print(f"   Private: {MY_PRIV_PATH}  (chmod 600)")
    print(f"   Public:  {MY_PUB_PATH}")
    print(f"   Fingerprint: {fingerprint}")
    print()
    print("Share your public key with friends:")
    print(f"   hytalecrypt export")


def cmd_export(args):
    """Export my public key as base64."""
    if not MY_PUB_PATH.exists():
        print(f"❌ No public key found. Run: hytalecrypt gen", file=sys.stderr)
        sys.exit(1)
    pub = _load_pubkey(MY_PUB_PATH)
    b64 = _pubkey_to_b64(pub)
    print("--- YOUR PUBLIC KEY (share this) ---")
    print(b64)
    print("--- END ---")
    print()
    print("Friends import it with:")
    print(f"   hytalecrypt import '{args.name or 'theirname'}' <paste_the_key_here>")


def cmd_import(args):
    """Import a friend's public key."""
    _ensure_dirs()
    name = args.name
    b64 = args.key.strip()
    try:
        pub = _b64_to_pubkey(b64)
    except Exception as e:
        print(f"❌ Invalid public key: {e}", file=sys.stderr)
        sys.exit(1)

    dest = FRIENDS_DIR / f"{name}.pub"
    pem = pub.public_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.PublicFormat.SubjectPublicKeyInfo,
    )
    dest.write_bytes(pem)

    fingerprint = _hc.fingerprint(pub)

    print(f"✅ Imported public key for '{name}'")
    print(f"   Fingerprint: {fingerprint}")
    print(f"   Saved to: {dest}")
    print()
    print("Now you can encrypt messages to them:")
    print(f"   hytalecrypt encrypt '{name}' \"Hello, secret!\"")


def cmd_list(args):
    """List my key and all known friends."""
    _ensure_dirs()
    print("=== MY KEY ===")
    if MY_PUB_PATH.exists():
        pub = _load_pubkey(MY_PUB_PATH)
        fingerprint = _hc.fingerprint(pub)
        print(f"   Fingerprint: {fingerprint}")
    else:
        print("   (none — run 'hytalecrypt gen')")

    print()
    print("=== FRIENDS ===")
    friends = sorted(FRIENDS_DIR.glob("*.pub"))
    if friends:
        for f in friends:
            pub = _load_pubkey(f)
            fingerprint = _hc.fingerprint(pub)
            print(f"   {f.stem:20s}  RSA {fingerprint}")
    else:
        print("   (none — import some with 'hytalecrypt import <name> <key>')")

    print()
    print("=== SHARED KEYS (tunnel) ===")
    psk = _hc.list_psk_friends()
    if psk:
        for name in psk:
            print(f"   {name:20s}  AES {_hc.key_fingerprint(_hc.load_psk(name))}")
    else:
        print("   (none — create one with 'hytalecrypt genkey' + 'setkey <name> <key>')")


def cmd_encrypt(args):
    """Encrypt a message for a friend."""
    friend = args.recipient
    message = args.message
    _friend_pubkey(friend)  # validate + friendly error if unknown

    try:
        b64_blob = _hc.encrypt_for(friend, message)
    except ValueError as e:
        print(f"❌ Message too long! ({e})", file=sys.stderr)
        print("   Keep messages under ~190 characters for 2048-bit RSA.", file=sys.stderr)
        sys.exit(1)

    print(f"🔐 Encrypted for {friend}")
    print()
    print("Paste this into Hytale chat:")
    print(f"   /msg {friend} {b64_blob}")
    print()
    print(f"Encrypted message size: {len(b64_blob)} chars (base64)")


def cmd_decrypt(args):
    """Decrypt an encrypted blob using my private key."""
    b64_blob = args.blob.strip()
    try:
        ciphertext = base64.b64decode(b64_blob)
    except Exception as e:
        print(f"❌ Invalid base64: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        plaintext = _hc.decrypt_blob(b64_blob)
    except Exception as e:
        print(f"❌ Decryption failed: {e}", file=sys.stderr)
        print("   Make sure you used the right private key and the blob is intact.", file=sys.stderr)
        sys.exit(1)

    print(f"🔓 Decrypted message:")
    print()
    print(plaintext)


def cmd_genkey(args):
    """Generate a shared key for the symmetric tunnel (fits the 255-char limit)."""
    key = _hc.gen_psk()
    print("--- SHARED TUNNEL KEY (give this to your ONE friend, out of band) ---")
    print(key)
    print("--- END ---")
    print()
    print("Both of you then run:")
    print(f"   hytalecrypt setkey <theirname> {key}")


def cmd_setkey(args):
    """Store a shared key for a friend (you both use the SAME key)."""
    try:
        path = _hc.set_psk(args.name, args.key)
    except Exception as e:
        print(f"❌ Invalid key: {e}", file=sys.stderr)
        sys.exit(1)
    raw = _hc.load_psk(args.name)
    print(f"✅ Shared key stored for '{args.name}'")
    print(f"   Key fingerprint: {_hc.key_fingerprint(raw)}  (compare with your friend!)")
    print(f"   Saved to: {path}")
    print()
    print(f"Now: hytalecrypt senc {args.name} \"secret message\"")


def cmd_senc(args):
    """Symmetric-encrypt a message for a friend; output a /msg line that fits chat."""
    friend, message = args.recipient, args.message
    try:
        token = _hc.encrypt_sym(friend, message)
    except KeyError as e:
        print(f"❌ {e}", file=sys.stderr)
        sys.exit(1)
    except ValueError as e:
        print(f"❌ {e}", file=sys.stderr)
        sys.exit(1)
    line = f"/msg {friend} {token}"
    print(f"🔐 Encrypted for {friend}")
    print()
    print("Paste this into Hytale chat:")
    print(f"   {line}")
    print()
    print(f"Line length: {len(line)} / {_hc.CHAT_LIMIT} chars")


def cmd_sdec(args):
    """Symmetric-decrypt a token (with or without the /msg prefix or HX1 marker)."""
    blob = args.blob.strip()
    if blob.startswith("/msg "):                       # tolerate a pasted whole line
        blob = blob.split(None, 2)[-1]
    if blob.startswith(_hc.SYM_MARKER):
        blob = blob[len(_hc.SYM_MARKER):]
    res = _hc.try_decrypt_sym(blob)
    if res is None:
        print("❌ Decryption failed (no matching shared key, or token corrupt).",
              file=sys.stderr)
        sys.exit(1)
    sender, plaintext = res
    print(f"🔓 From {sender}:")
    print()
    print(plaintext)


def cmd_help(args):
    """Show help."""
    parser.print_help()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

parser = argparse.ArgumentParser(
    prog="hytalecrypt",
    description="End-to-End encrypted messaging for Hytale in-game chat.",
    epilog=(
        "EXCHANGE KEYS ONCE:\n"
        "  1. Both run:         hytalecrypt gen\n"
        "  2. Each exports:     hytalecrypt export\n"
        "  3. Each imports:     hytalecrypt import PlayerName <their_key_b64>\n\n"
        "EVERY SESSION:\n"
        "  Encrypt:  hytalecrypt encrypt FriendName \"secret message\"\n"
        "  Paste:    /msg FriendName <blob>\n"
        "  The other copies the blob from chat and runs:\n"
        "  Decrypt:  hytalecrypt decrypt <blob>"
    ),
    formatter_class=argparse.RawDescriptionHelpFormatter,
)
sub = parser.add_subparsers(dest="command", required=True)

p_gen   = sub.add_parser("gen",     help="Generate a new RSA keypair")
p_export = sub.add_parser("export",  help="Export your public key (share with friends)")
p_export.add_argument("name", nargs="?", default="friend", help="Name hint for the recipient (default: friend)")

p_import = sub.add_parser("import", help="Import a friend's public key")
p_import.add_argument("name", help="Friend's name/alias")
p_import.add_argument("key",  help="Their public key (base64 string)")

p_list  = sub.add_parser("list",    help="List your key and known friends")

p_enc   = sub.add_parser("encrypt", help="Encrypt a message for a friend")
p_enc.add_argument("recipient", help="Friend's name (must have their pubkey imported)")
p_enc.add_argument("message",   help="The message to encrypt")

p_dec   = sub.add_parser("decrypt", help="Decrypt an encrypted blob from chat")
p_dec.add_argument("blob",     help="The base64 encrypted blob from /msg")

# Symmetric tunnel (AES-256-GCM, shared key) — short blobs that fit 255 chars.
p_genkey = sub.add_parser("genkey", help="Generate a shared tunnel key to give a friend")

p_setkey = sub.add_parser("setkey", help="Store a friend's shared tunnel key")
p_setkey.add_argument("name", help="Friend's name/alias (must match their in-game name)")
p_setkey.add_argument("key",  help="The shared key (base64, from genkey)")

p_senc  = sub.add_parser("senc",    help="Symmetric-encrypt a message (fits chat limit)")
p_senc.add_argument("recipient", help="Friend's name (must have a shared key)")
p_senc.add_argument("message",   help="The message to encrypt")

p_sdec  = sub.add_parser("sdec",    help="Symmetric-decrypt a token from chat")
p_sdec.add_argument("blob",     help="The HX1... token (or whole /msg line)")

p_help  = sub.add_parser("help",    help="Show this help and exit")


if __name__ == "__main__":
    args = parser.parse_args()

    cmds = {
        "gen":     cmd_gen,
        "export":  cmd_export,
        "import":  cmd_import,
        "list":    cmd_list,
        "encrypt":  cmd_encrypt,
        "decrypt":  cmd_decrypt,
        "genkey":  cmd_genkey,
        "setkey":  cmd_setkey,
        "senc":    cmd_senc,
        "sdec":    cmd_sdec,
        "help":    cmd_help,
    }
    cmds[args.command](args)
